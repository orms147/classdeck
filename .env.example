# --- Model API (any OpenAI-compatible endpoint) -------------------------------------------
# Recommended daily setup: OpenRouter with an inexpensive model. Measured cost: about $0.002
# per drafted period on openai/gpt-6-luna (docs/llm-provider.md). Alternatives:
#   DeepSeek via OpenRouter   CLASSDECK_MODEL=deepseek/deepseek-v4.1-flash-1017
#   DeepSeek direct           MODEL_API_BASE_URL=https://api.deepseek.com   CLASSDECK_MODEL=<their id>
#   Meta Model API            MODEL_API_BASE_URL=https://api.meta.ai/v1     CLASSDECK_MODEL=muse-spark-1.3
MODEL_API_KEY=
MODEL_API_BASE_URL=https://openrouter.ai/api/v1
CLASSDECK_MODEL=openai/gpt-6-luna

# "api" calls the endpoint above. "mock" uses the deterministic template pipeline — no network,
# no cost — for offline development, CI and the prompt-pack workflow.
CLASSDECK_PROVIDER=api

# Disk cache for model responses (keyed by prompt hash). Re-running a period costs nothing.
# Leave empty to disable.
CLASSDECK_CACHE_DIR=.cache/llm

# Where lessons, ingested sources, images and exports are written.
CLASSDECK_WORKDIR=out

# Curriculum config root (see docs/curriculum-config.md).
CLASSDECK_CURRICULUM_DIR=curriculum

# --- Evaluation judge (optional) --------------------------------------------------------
# An independent model that scores generated lessons in `classdeck eval` (rubric in
# docs/evaluation.md). Use a different model family from the generator to avoid
# self-preference bias. Any OpenAI-compatible endpoint works. When unset, eval scores with
# the generator model and marks the result as such.
# Example (OpenRouter, a different family from the generator):
#   JUDGE_API_BASE_URL=https://openrouter.ai/api/v1   JUDGE_MODEL=<a model from another family than the generator>
JUDGE_API_KEY=
JUDGE_API_BASE_URL=
JUDGE_MODEL=
